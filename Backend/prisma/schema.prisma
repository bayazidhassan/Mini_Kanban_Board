
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid(2))
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  ownedBoards  Board[]
  boardMembers BoardMember[]
}

model Board {
  id          String        @id @default(cuid(2))
  name        String
  description String?
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     BoardMember[]
  columns     Column[]

  @@index([ownerId])
}

model BoardMember {
  id        String   @id @default(cuid(2))
  boardId   String
  userId    String
  createdAt DateTime @default(now())

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model Column {
  id        String   @id @default(cuid(2))
  name      String
  position  Int
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
}

model Task {
  id          String   @id @default(cuid(2))
  title       String
  description String?
  position    Int
  columnId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}